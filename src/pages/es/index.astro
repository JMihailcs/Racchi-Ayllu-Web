---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Card from '../../components/Card.astro';
---
<Layout title="Racchi Ayllu — Huayllabamba — Urubamba — Cusco" description="Primer registro público de la fiesta de Racchi Ayllu, comunidad campesina.">

  <div class="scroll-wrapper fixed top-0 left-0 w-full min-h-screen will-change-transform z-0">

    <!-- CINEMATIC HERO SECTION -->
    <section class="relative w-full h-[120vh] overflow-hidden flex items-center justify-center bg-cinta-azul" id="hero-cinematic">
      <!-- Background Sky -->
      <img src="https://raft-blast-61784561.figma.site/_assets/v11/16b5007d9c93971e26ffe4e0e3e37946f6bd538c.png" class="hero-layer layer-sky absolute top-0 left-0 w-full h-full object-cover" alt="" onerror="this.style.display='none'" />

      <!-- Back Mountains / Glow -->
      <img src="https://raft-blast-61784561.figma.site/_assets/v11/8a7f8af50e0ce92ec2e228e7b0b4112178c51cf1.png" class="hero-layer layer-back absolute top-0 left-0 w-full h-full object-cover" alt="" onerror="this.style.display='none'" />

      <!-- Title (Behind Front Layers) -->
      <div class="relative z-10 text-center hero-title-wrapper pointer-events-none mt-[-15vh]">
        <h1 class="text-[5rem] md:text-[10rem] font-bold text-white tracking-widest font-display leading-[1.1] drop-shadow-[0_10px_20px_rgba(0,0,0,0.8)] uppercase">Racchi<br/>Ayllu</h1>
      </div>

      <!-- Midground -->
      <img src="https://raft-blast-61784561.figma.site/_assets/v11/864afe00e41e2fa20a5aa546e15cb807e0f81384.png" class="hero-layer layer-mid absolute top-0 left-0 w-full h-full object-cover z-20 pointer-events-none" alt="" onerror="this.style.display='none'" />

      <!-- Left Split -->
      <img src="https://raft-blast-61784561.figma.site/_assets/v11/7bd7e30dce4dc744b8b60f152b1156fcbc171d99.png" class="hero-layer layer-left absolute top-0 left-0 w-full h-full object-cover z-30 pointer-events-none origin-bottom-left" alt="" onerror="this.style.display='none'" />

      <!-- Right Split -->
      <img src="https://raft-blast-61784561.figma.site/_assets/v11/673dbb11f38e6530664d603a1157143973c9ff48.png" class="hero-layer layer-right absolute top-0 left-0 w-full h-full object-cover z-30 pointer-events-none origin-bottom-right" alt="" onerror="this.style.display='none'" />

      <!-- Foreground -->
      <img src="https://raft-blast-61784561.figma.site/_assets/v11/1ce8424fa7de09e20037a54a938c4bb1a8f93e2b.png" class="hero-layer layer-fore absolute top-0 left-0 w-full h-full object-cover z-40 pointer-events-none" alt="" onerror="this.style.display='none'" />
    </section>

    <!-- MAIN CONTENT BELOW HERO -->
    <div class="relative z-40 bg-white border-t border-tierra/20 shadow-2xl">
      <Section>
        <div class="text-center">
          <Eyebrow tone="azul">comunidad campesina</Eyebrow>
          <h2 class="text-4xl md:text-6xl text-cinta-azul mb-8">Patrimonio vivo del Valle Sagrado</h2>
        </div>
        <p class="text-xl md:text-2xl leading-relaxed text-center">Racchi Ayllu es una comunidad campesina del distrito de Huayllabamba, provincia de Urubamba. En su jurisdicción, la cultura viva persiste a través del tiempo.</p>
        <p class="mt-10 text-center font-mono text-[13px] text-chonta/60">Racchi Ayllu — Huayllabamba, Urubamba, Cusco. No confundir con Raqchi de San Pedro, Canchis.</p>
      </Section>

      <!-- QUICK FACTS SECTION -->
      <Section width="wide" alt>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="text-center py-4">
            <p class="font-display text-3xl md:text-4xl text-chonta mb-2">~3,652 m</p>
            <p class="font-mono text-[13px] text-chonta/60">altitud</p>
          </div>
          <div class="text-center py-4">
            <p class="font-display text-3xl md:text-4xl text-chonta mb-2">21–25 ago</p>
            <p class="font-mono text-[13px] text-chonta/60">fiesta de la Asunta</p>
          </div>
          <div class="text-center py-4">
            <p class="font-display text-3xl md:text-4xl text-chonta mb-2">6</p>
            <p class="font-mono text-[13px] text-chonta/60">comparsas</p>
          </div>
          <div class="text-center py-4">
            <p class="font-display text-3xl md:text-4xl text-chonta mb-2">Huayllabamba</p>
            <p class="font-mono text-[13px] text-chonta/60">distrito</p>
          </div>
        </div>
      </Section>

      <!-- SOBRE LA COMUNIDAD -->
      <Section>
        <div class="text-center mb-12">
          <Eyebrow>nuestra historia</Eyebrow>
          <h2 class="text-4xl md:text-5xl text-cinta-azul">Corazón de los Andes</h2>
        </div>
        <div class="text-lg md:text-xl leading-relaxed space-y-6">
          <p>
            Racchi Ayllu es mucho más que un territorio; es una herencia cultural viva. Ubicada en la parte alta del Valle Sagrado, nuestra comunidad ha mantenido sus tradiciones desde tiempos inmemoriales, sosteniendo una economía basada en la agricultura y la ganadería.
          </p>
          <p>
            Hoy en día, somos un punto emergente e importante para el <strong>turismo vivencial</strong>. Aquí, compartimos nuestra textilería andina ancestral y el cuidado de nuestras alpacas y llamas, abriendo nuestras puertas para que el mundo experimente el verdadero respeto por la Pachamama.
          </p>
        </div>
      </Section>

      <!-- FESTIVIDADES Y CULTURA -->
      <Section width="wide" alt>
        <div class="max-w-[68ch] mx-auto mb-12 text-center">
          <Eyebrow>expresiones culturales</Eyebrow>
          <h2 class="text-4xl md:text-5xl text-cinta-azul">Nuestras festividades</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <Card href="/es/festividades/virgen-asunta">
            <h3 class="text-2xl md:text-3xl text-chonta mb-3">La Virgen Asunta</h3>
            <p class="text-lg text-chonta/80">Una festividad única del 21 al 25 de agosto, a diferencia del resto del Valle Sagrado.</p>
            <p class="mt-6 font-mono text-[13px] text-cinta-azul">explorar →</p>
          </Card>
          <Card href="/es/festividades/virgen-asunta/comparsas/qapaq-chunchu">
            <h3 class="text-2xl md:text-3xl text-chonta mb-3">Qapaq Chunchu</h3>
            <p class="text-lg text-chonta/80">Danza de los guerreros amazónicos. Evolución contemporánea del antiguo Iriji Chunchu.</p>
            <p class="mt-6 font-mono text-[13px] text-cinta-azul">leer ficha →</p>
          </Card>
        </div>
      </Section>

      <!-- MAPA -->
      <Section width="wide">
        <div class="text-center mb-12">
          <Eyebrow>encuéntranos</Eyebrow>
          <h2 class="text-4xl md:text-5xl text-cinta-azul">Nuestra ubicación</h2>
        </div>
        <div class="w-full h-[500px] rounded-2xl overflow-hidden border border-tierra/20 bg-suri/40">
          <iframe
            src="https://maps.google.com/maps?q=Centro+Comunal+de+Racchy+Ayllo&hl=es&z=16&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
        <p class="text-center mt-6 text-chonta/60 font-mono text-[13px]">En Google Maps figura como “Racchy Ayllo”; la ubicación del Centro Comunal es la correcta.</p>
      </Section>
    </div>
  </div>
</Layout>

<style>
  :root {
    --scroll-progress: 0;
  }

  .layer-sky {
    transform: scale(calc(1 + var(--scroll-progress) * 0.1)) translateY(calc(var(--scroll-progress) * 15%));
  }
  .layer-back {
    transform: scale(calc(1 + var(--scroll-progress) * 0.15)) translateY(calc(var(--scroll-progress) * 10%));
  }
  .hero-title-wrapper {
    transform: translateY(calc(var(--scroll-progress) * 50%));
    opacity: calc(1 - var(--scroll-progress) * 2);
  }
  .layer-mid {
    transform: scale(calc(1 + var(--scroll-progress) * 0.3));
  }
  .layer-left {
    transform: translateX(calc(var(--scroll-progress) * -20%)) scale(calc(1 + var(--scroll-progress) * 0.4));
  }
  .layer-right {
    transform: translateX(calc(var(--scroll-progress) * 20%)) scale(calc(1 + var(--scroll-progress) * 0.4));
  }
  .layer-fore {
    transform: translateY(calc(var(--scroll-progress) * -10%)) scale(calc(1 + var(--scroll-progress) * 0.1));
  }
</style>

<script>
  import { initMotion } from '../../scripts/motion.js';
  // Initialize only on client
  if (typeof window !== 'undefined') {
    initMotion();
  }
</script>
