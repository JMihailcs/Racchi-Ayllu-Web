---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ProcedenciaBloque from '../../../components/ProcedenciaBloque.astro';
import PageHero from '../../../components/PageHero.astro';
import Section from '../../../components/Section.astro';
import Eyebrow from '../../../components/Eyebrow.astro';
import Button from '../../../components/Button.astro';

export async function getStaticPaths() {
  const festividades = await getCollection('festividades');
  return festividades.map(festividad => ({
    params: { id: festividad.id },
    props: { festividad },
  }));
}

const { festividad } = Astro.props;
const { Content } = await render(festividad);
const data = festividad.data;
---
<Layout title={`${data.nombre} | Racchi Ayllu — Huayllabamba — Urubamba — Cusco`} description={data.resumen}>
  <PageHero
    eyebrow="festividad mayor"
    title={data.nombre}
    meta={`${data.fechaInicio} — ${data.fechaFin}`}
    description={data.resumen}
  />

  <Section>
    <a href="/es/" class="font-mono text-[13px] text-chonta/60 hover:text-cinta-azul mb-8 inline-block">← volver al inicio</a>
    <div class="text-lg md:text-xl leading-relaxed space-y-6">
      <Content />
    </div>
    <div class="mt-12">
      <Button href={`/es/festividades/${festividad.id}/comparsas`}>
        Ver comparsas participantes →
      </Button>
    </div>
  </Section>

  {data.dias && data.dias.length > 0 && (
    <Section alt>
      <Eyebrow>calendario</Eyebrow>
      <h2 class="text-3xl md:text-4xl text-cinta-azul mb-12">Calendario de actividades</h2>
      <div class="border-l-2 border-tierra/25 ml-2 space-y-12">
        {data.dias.map((dia: any) => {
          const esKacharpariy = dia.nombre === 'Kacharpariy';
          const dot = esKacharpariy
            ? 'bg-naranja ring-naranja/20'
            : 'bg-cinta-azul ring-cinta-azul/15';
          return (
            <div class="relative pl-10">
              <div class={`absolute -left-[7px] top-2 w-3.5 h-3.5 rounded-full ring-4 ${dot}`}></div>
              <h3 class="text-2xl md:text-3xl text-chonta flex items-center flex-wrap gap-3">
                {dia.fecha}
                {dia.nombre && <span class="text-lg md:text-xl text-chonta/60">({dia.nombre})</span>}
                {dia.central && <span class="font-mono text-[12px] px-3 py-1 rounded-full bg-cinta-azul/10 text-cinta-azul">día central</span>}
              </h3>
              <div class="mt-4">
                <ProcedenciaBloque tipo={dia.procedencia}>
                  <ul class="list-disc pl-6 space-y-3 text-lg text-chonta/90">
                    {dia.actividades.map((actividad: string) => (
                      <li>{actividad}</li>
                    ))}
                  </ul>
                </ProcedenciaBloque>
              </div>
            </div>
          );
        })}
      </div>
    </Section>
  )}

  {data.fuentes && data.fuentes.length > 0 && (
    <Section>
      <Eyebrow>fuentes</Eyebrow>
      <ul class="font-mono text-[13px] text-chonta/60 space-y-2">
        {data.fuentes.map((fuente: string) => (
          <li>{fuente}</li>
        ))}
      </ul>
    </Section>
  )}
</Layout>
