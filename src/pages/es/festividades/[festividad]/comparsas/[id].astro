---
import { getCollection, render } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import ProcedenciaBloque from '../../../../../components/ProcedenciaBloque.astro';
import PageHero from '../../../../../components/PageHero.astro';
import Section from '../../../../../components/Section.astro';
import Eyebrow from '../../../../../components/Eyebrow.astro';
import Card from '../../../../../components/Card.astro';

export async function getStaticPaths() {
  const festividades = await getCollection('festividades');
  const comparsas = await getCollection('comparsas');

  return festividades.flatMap(festividad => {
    return festividad.data.comparsas.map((cId: string) => {
      const comparsa = comparsas.find(c => c.id === cId);
      if (!comparsa) return null;
      return {
        params: { festividad: festividad.id, id: comparsa.id },
        props: { festividad, comparsa },
      };
    }).filter(Boolean);
  });
}

const { festividad, comparsa } = Astro.props;
const { Content } = await render(comparsa);
const data = comparsa.data;
---
<Layout title={`${data.nombre} | ${festividad.data.nombre} | Racchi Ayllu — Huayllabamba — Urubamba — Cusco`} description={data.resumen}>
  <PageHero
    eyebrow="comparsa"
    title={data.nombre}
    description={data.resumen}
  />

  <Section>
    <nav class="flex items-center gap-3 font-mono text-[13px] text-chonta/60 mb-10 flex-wrap" aria-label="Ruta de navegación">
      <a href="/es/" class="hover:text-cinta-azul">inicio</a>
      <span>/</span>
      <a href={`/es/festividades/${festividad.id}`} class="hover:text-cinta-azul">{festividad.data.nombre.toLowerCase()}</a>
      <span>/</span>
      <a href={`/es/festividades/${festividad.id}/comparsas`} class="hover:text-cinta-azul">comparsas</a>
    </nav>

    <div class="bg-suri/40 rounded-2xl p-8 md:p-10 text-lg md:text-xl leading-relaxed space-y-6">
      <Content />
    </div>
  </Section>

  {data.historia && data.historia.length > 0 && (
    <Section>
      <Eyebrow>origen</Eyebrow>
      <h2 class="text-3xl md:text-4xl text-cinta-azul mb-8">Historia</h2>
      <div class="space-y-6">
        {data.historia.map((h: any) => (
          <ProcedenciaBloque tipo={h.procedencia}>
            <p class="text-lg text-chonta/90">{h.texto}</p>
            {h.fuente && <p class="font-mono text-[13px] mt-3 text-chonta/60">fuente: {h.fuente}</p>}
          </ProcedenciaBloque>
        ))}
      </div>
    </Section>
  )}

  {data.personajes && data.personajes.length > 0 && (
    <Section>
      <Eyebrow>organización</Eyebrow>
      <h2 class="text-3xl md:text-4xl text-cinta-azul mb-8">Personajes</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b border-tierra/25">
              <th class="py-4 pr-6 font-mono text-[13px] font-normal text-chonta/60">personaje</th>
              <th class="py-4 pr-6 font-mono text-[13px] font-normal text-chonta/60">cantidad</th>
              <th class="py-4 font-mono text-[13px] font-normal text-chonta/60">función</th>
            </tr>
          </thead>
          <tbody>
            {data.personajes.map((p: any) => (
              <tr class="border-b border-tierra/20 align-top">
                <td class="py-5 pr-6 font-bold text-chonta text-lg whitespace-nowrap">{p.nombre}</td>
                <td class="py-5 pr-6 font-mono text-[13px] text-chonta/80 whitespace-nowrap">{p.cantidad}</td>
                <td class="py-5">
                  <ProcedenciaBloque tipo={p.procedencia}>
                    <span class="text-chonta/90">{p.funcion}</span>
                  </ProcedenciaBloque>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>
  )}

  {data.vestimenta && data.vestimenta.length > 0 && (
    <Section width="wide">
      <div class="max-w-[68ch] mb-8">
        <Eyebrow>traje</Eyebrow>
        <h2 class="text-3xl md:text-4xl text-cinta-azul">Vestimenta</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {data.vestimenta.map((v: any) => (
          <Card>
            <h3 class="text-2xl text-chonta mb-4">
              {v.pieza} {v.quechua && <span class="quechua text-lg text-chonta/60">({v.quechua})</span>}
            </h3>
            <ProcedenciaBloque tipo={v.procedencia}>
              <p class="text-chonta/90">{v.descripcion}</p>
              {v.material && <p class="font-mono text-[13px] mt-3 text-chonta/60">material: {v.material}</p>}
              {v.costo && <p class="font-mono text-[13px] mt-1 text-chonta/60">costo: {v.costo}</p>}
              {v.significado && <p class="mt-3 text-chonta/90">{v.significado}</p>}
            </ProcedenciaBloque>
          </Card>
        ))}
      </div>
    </Section>
  )}

  {data.musica && (
    <Section>
      <Eyebrow>sonido</Eyebrow>
      <h2 class="text-3xl md:text-4xl text-cinta-azul mb-8">Música</h2>
      <ProcedenciaBloque tipo={data.musica.procedencia}>
        <p class="font-mono text-[13px] text-chonta/80 mb-6">
          {data.musica.instrumentos.join(' · ')}
        </p>
        <div class="space-y-6">
          {data.musica.mudanzas.map((m: any) => (
            <ProcedenciaBloque tipo={m.procedencia}>
              <p class="text-lg text-chonta/90">
                {m.numero && <span class="font-mono text-[13px] text-chonta/60 mr-2">{m.numero}</span>}
                {m.nombre && <strong>{m.nombre}</strong>}
                {m.nombre && m.descripcion && <span> — </span>}
                {m.descripcion && <span>{m.descripcion}</span>}
              </p>
            </ProcedenciaBloque>
          ))}
        </div>
      </ProcedenciaBloque>
    </Section>
  )}

  {data.fuentes && data.fuentes.length > 0 && (
    <Section>
      <Eyebrow>fuentes</Eyebrow>
      <ul class="font-mono text-[13px] text-chonta/60 space-y-2">
        {data.fuentes.map((fuente: string) => (
          <li>{fuente}</li>
        ))}
      </ul>
    </Section>
  )}
</Layout>
