---
import { getCollection, render } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import ProcedenciaBloque from '../../../../../components/ProcedenciaBloque.astro';

export async function getStaticPaths() {
  const festividades = await getCollection('festividades');
  const comparsas = await getCollection('comparsas');

  return festividades.flatMap(festividad => {
    return festividad.data.comparsas.map((cId: string) => {
      const comparsa = comparsas.find(c => c.id === cId);
      if (!comparsa) return null;
      return {
        params: { festividad: festividad.id, id: comparsa.id },
        props: { festividad, comparsa },
      };
    }).filter(Boolean);
  });
}

const { festividad, comparsa } = Astro.props;
const { Content } = await render(comparsa);
const data = comparsa.data;
---
<Layout title={`${data.nombre} | ${festividad.data.nombre} | Racchi Ayllu`} description={data.resumen} theme="chunchu">
  <div class="scroll-wrapper w-full min-h-screen bg-white">
    
    <!-- IMMERSIVE HERO -->
    <section class="relative w-full h-[70vh] overflow-hidden flex items-center justify-center bg-[#C91C1C]">
      <!-- Malla negra decorativa (simulando la máscara del chunchu) -->
      <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(black 2px, transparent 2px); background-size: 16px 16px;"></div>
      
      <!-- Plumas decorativas (SVGs abstractos) -->
      <svg class="absolute top-10 left-10 w-32 h-32 text-white/30 transform -rotate-45" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C8 4 3 9 3 14c0 3.5 2 6.5 5 8 .5-1 1.5-2 2.5-3-1-1-1.5-2-1.5-3 0-2 1.5-4 3-5 1.5 1 3 3 3 5 0 1-.5 2-1.5 3 1 1 2 2 2.5 3 3-1.5 5-4.5 5-8 0-5-5-10-9-14z"/></svg>
      <svg class="absolute bottom-10 right-20 w-48 h-48 text-white/20 transform rotate-45" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C8 4 3 9 3 14c0 3.5 2 6.5 5 8 .5-1 1.5-2 2.5-3-1-1-1.5-2-1.5-3 0-2 1.5-4 3-5 1.5 1 3 3 3 5 0 1-.5 2-1.5 3 1 1 2 2 2.5 3 3-1.5 5-4.5 5-8 0-5-5-10-9-14z"/></svg>

      <div class="relative z-10 text-center px-6 w-full max-w-7xl mx-auto">
        <span class="mono-font text-sm md:text-lg uppercase tracking-widest text-black font-bold mb-6 bg-white inline-block px-6 py-2 rounded-full border-2 border-black shadow-lg">Comparsa de Danza</span>
        <h1 class="text-6xl md:text-[8rem] font-bold text-white tracking-tight font-display drop-shadow-2xl mb-8">{data.nombre}</h1>
        <p class="text-xl md:text-2xl mt-4 text-black bg-white/90 inline-block px-8 py-3 font-bold font-display border-b-4 border-black shadow-xl">{data.resumen}</p>
      </div>
    </section>

    <!-- CONTENT -->
    <div class="max-w-[68ch] mx-auto px-6 pt-16 pb-24">
      <div class="flex items-center gap-4 text-black font-bold mono-font text-sm uppercase tracking-wider mb-12 flex-wrap border-b-2 border-[#C91C1C] pb-4">
        <a href="/es/" class="hover:text-[#C91C1C] transition-colors">Inicio</a>
        <span>/</span>
        <a href={`/es/festividades/${festividad.id}`} class="hover:text-[#C91C1C] transition-colors">{festividad.data.nombre}</a>
        <span>/</span>
        <a href={`/es/festividades/${festividad.id}/comparsas`} class="hover:text-[#C91C1C] transition-colors">Comparsas</a>
      </div>
    
      <div class="text-black mb-16 text-lg md:text-xl leading-relaxed bg-white p-8 md:p-10 border-l-[8px] border-[#C91C1C] rounded-r-xl shadow-md relative overflow-hidden">
        <div class="absolute inset-0 opacity-5 pointer-events-none" style="background-image: linear-gradient(45deg, black 25%, transparent 25%, transparent 75%, black 75%, black), linear-gradient(45deg, black 25%, transparent 25%, transparent 75%, black 75%, black); background-size: 20px 20px; background-position: 0 0, 10px 10px;"></div>
        <div class="relative z-10"><Content /></div>
      </div>

      {data.historia && data.historia.length > 0 && (
        <section class="mt-16">
          <h2 class="text-4xl font-bold text-[#C91C1C] mb-8 font-display border-b-4 border-black pb-2 inline-block">Historia y Origen</h2>
          <div class="space-y-6">
            {data.historia.map((h: any) => (
              <ProcedenciaBloque tipo={h.procedencia}>
                <p class="text-lg text-black">{h.texto}</p>
                {h.fuente && <p class="text-sm mt-3 font-bold text-black uppercase tracking-widest mono-font bg-[#C91C1C]/10 inline-block px-3 py-1 rounded-sm">Fuente: {h.fuente}</p>}
              </ProcedenciaBloque>
            ))}
          </div>
        </section>
      )}

      {data.personajes && data.personajes.length > 0 && (
        <section class="mt-20">
          <h2 class="text-4xl font-bold text-[#C91C1C] mb-8 font-display border-b-4 border-black pb-2 inline-block">Estructura y Personajes</h2>
          <div class="overflow-x-auto shadow-xl rounded-xl border-2 border-black bg-white">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b-4 border-black bg-[#C91C1C] text-white">
                  <th class="p-5 font-bold text-lg font-display tracking-widest uppercase">Personaje</th>
                  <th class="p-5 font-bold text-lg font-display tracking-widest uppercase">Cantidad</th>
                  <th class="p-5 font-bold text-lg font-display tracking-widest uppercase">Función</th>
                </tr>
              </thead>
              <tbody>
                {data.personajes.map((p: any) => (
                  <tr class="border-b-2 border-black/10 hover:bg-[#C91C1C]/5 transition-colors text-black">
                    <td class="p-5 font-bold align-top text-[#C91C1C] text-xl">{p.nombre}</td>
                    <td class="p-5 mono-font align-top text-black font-bold text-lg">{p.cantidad}</td>
                    <td class="p-5 align-top">
                      <ProcedenciaBloque tipo={p.procedencia}>
                        {p.funcion}
                      </ProcedenciaBloque>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {data.vestimenta && data.vestimenta.length > 0 && (
        <section class="mt-20">
          <h2 class="text-4xl font-bold text-[#C91C1C] mb-8 font-display border-b-4 border-black pb-2 inline-block">Detalle de Vestimenta</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {data.vestimenta.map((v: any) => (
              <div class="bg-white border-2 border-black hover:border-[#C91C1C] p-8 rounded-xl shadow-lg hover:shadow-2xl transition-all relative overflow-hidden group hover:-translate-y-1">
                <div class="absolute top-0 right-0 w-32 h-32 bg-[#C91C1C] rounded-bl-full opacity-10 group-hover:opacity-100 transition-opacity z-0">
                  <!-- Icono de pluma en hover -->
                  <svg class="absolute top-6 right-6 w-12 h-12 text-white transform rotate-45 opacity-0 group-hover:opacity-100 transition-opacity" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C8 4 3 9 3 14c0 3.5 2 6.5 5 8 .5-1 1.5-2 2.5-3-1-1-1.5-2-1.5-3 0-2 1.5-4 3-5 1.5 1 3 3 3 5 0 1-.5 2-1.5 3 1 1 2 2 2.5 3 3-1.5 5-4.5 5-8 0-5-5-10-9-14z"/></svg>
                </div>
                <h3 class="text-2xl font-bold mb-4 text-[#C91C1C] font-display relative z-10 flex flex-col group-hover:text-black transition-colors">
                  {v.pieza} {v.quechua && <span class="quechua font-normal text-black mt-1 text-lg">({v.quechua})</span>}
                </h3>
                <div class="relative z-10">
                  <ProcedenciaBloque tipo={v.procedencia}>
                    <p class="text-lg text-black">{v.descripcion}</p>
                    {v.material && <p class="mt-6 text-xs mono-font bg-black text-white inline-block px-3 py-1.5 rounded-sm uppercase font-bold tracking-wider">Materia: {v.material}</p>}
                  </ProcedenciaBloque>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Layout>
