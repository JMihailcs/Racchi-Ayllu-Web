---
import { getCollection } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';
import PageHero from '../../../../../components/PageHero.astro';
import Section from '../../../../../components/Section.astro';
import Card from '../../../../../components/Card.astro';

export async function getStaticPaths() {
  const festividades = await getCollection('festividades');
  return festividades.map(festividad => ({
    params: { festividad: festividad.id },
    props: { festividad },
  }));
}

const { festividad } = Astro.props;
const data = festividad.data;

// Fetch all comparsas that are listed in this festividad
const allComparsas = await getCollection('comparsas');
const comparsasDeFiesta = allComparsas.filter(c => data.comparsas.includes(c.id));
---
<Layout title={`Comparsas de ${data.nombre} | Racchi Ayllu — Huayllabamba — Urubamba — Cusco`} description={`Lista de comparsas que participan en ${data.nombre}`}>
  <PageHero
    eyebrow={data.nombre.toLowerCase()}
    title="Comparsas participantes"
    description={`Las agrupaciones que danzan en honor a ${data.nombre}.`}
  />

  <Section width="wide">
    <a href={`/es/festividades/${festividad.id}`} class="font-mono text-[13px] text-chonta/60 hover:text-cinta-azul mb-10 inline-block">← volver a la festividad</a>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {data.comparsas.map((cId: string) => {
        const comparsa = comparsasDeFiesta.find(c => c.id === cId);

        if (!comparsa) {
          // Placeholder para comparsas aún no documentadas
          return (
            <div class="p-8 border-2 border-dashed border-tierra/40 rounded-2xl bg-white">
              <h3 class="text-2xl font-display text-chonta/60 capitalize mb-3">{cId.replace(/-/g, ' ')}</h3>
              <p class="font-mono text-[13px] text-chonta/60">pendiente de documentar</p>
            </div>
          );
        }

        return (
          <Card href={`/es/festividades/${festividad.id}/comparsas/${comparsa.id}`}>
            <h3 class="text-2xl text-chonta mb-3">{comparsa.data.nombre}</h3>
            <p class="text-chonta/80 line-clamp-3">{comparsa.data.resumen}</p>
            <p class="mt-6 font-mono text-[13px] text-cinta-azul">leer ficha →</p>
          </Card>
        );
      })}
    </div>
  </Section>
</Layout>
