---
interface Props {
  tipo: 'observado' | 'testimonio' | 'por-confirmar';
}
const { tipo } = Astro.props;

let borderClass = '';
if (tipo === 'observado') {
  borderClass = 'border-l-[3px] border-l-cinta-azul border-solid';
} else if (tipo === 'testimonio') {
  borderClass = 'border-l-[3px] border-l-cinta-rosa border-solid';
} else if (tipo === 'por-confirmar') {
  borderClass = 'border-l-[3px] border-l-tierra border-dashed';
}
---
<div class={`pl-4 py-1 my-6 ${borderClass}`}>
  <slot />
</div>
