---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  meta?: string;
}
const { eyebrow, title, description, meta } = Astro.props;
---
<header class="pt-32 md:pt-40 pb-14 md:pb-20">
  <div class="max-w-[68ch] mx-auto px-6">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h1 class="text-4xl md:text-6xl text-cinta-azul leading-[1.05] mb-6">{title}</h1>
    {meta && <p class="font-mono text-[13px] tracking-wide text-chonta/60 mb-6">{meta}</p>}
    {description && <p class="text-lg md:text-xl leading-relaxed text-chonta/80">{description}</p>}
  </div>
</header>
