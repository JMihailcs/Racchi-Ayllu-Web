---
interface Props {
  width?: 'text' | 'wide';
  alt?: boolean;
  id?: string;
}
const { width = 'text', alt = false, id } = Astro.props;
const max = width === 'wide' ? 'max-w-6xl' : 'max-w-[68ch]';
---
<section id={id} class:list={['py-20 md:py-28', alt && 'bg-suri/40']}>
  <div class:list={['mx-auto px-6', max]}>
    <slot />
  </div>
</section>
